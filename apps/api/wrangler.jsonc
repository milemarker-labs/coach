{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "coach",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-07",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true
    }
  },
  "upload_source_maps": true,
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    "APP_ORIGIN": "http://localhost:3000",
    "STRAVA_CLIENT_ID": "",
    "ALLOWED_STRAVA_ATHLETE_ID": ""
  },
  "env": {
    "production": {
      "vars": {
        "APP_ORIGIN": "https://coach.milemarklabs.com",
        "STRAVA_CLIENT_ID": "",
        "ALLOWED_STRAVA_ATHLETE_ID": ""
      },
      "hyperdrive": [
        {
          "binding": "HYPERDRIVE",
          "id": "00000000000000000000000000000000"
        }
      ]
    }
  },
  "routes": [
    {
      "pattern": "coach.milemarklabs.com",
      "custom_domain": true
    }
  ]
}
